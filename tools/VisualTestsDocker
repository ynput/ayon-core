FROM ubuntu:24.04 AS testsbase
ENV PYTHONUNBUFFERED=1
ENV QT_QPA_PLATFORM=offscreen

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    git \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxkbcommon0 \
    libdbus-1-3 \
    libfontconfig1 \
    libfreetype6 \
    libxcb1 \
    libxcb-icccm4 \
    libxcb-image0 \
    libxcb-keysyms1 \
    libxcb-randr0 \
    libxcb-render-util0 \
    libxcb-shape0 \
    libxcb-xinerama0 \
    libxcb-xfixes0 \
    libxkbcommon-x11-0 \
    libharfbuzz0b \
    libegl1 \
    libgles2 \
    libgl1 \
    libglvnd0 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

ADD https://astral.sh/uv/install.sh /uv-installer.sh
RUN sh /uv-installer.sh && rm /uv-installer.sh
ENV PATH="/root/.local/bin/:$PATH"
# CI uses actions/setup-python with '3.11', i.e. the latest 3.11 patch
RUN uv python install 3.11

FROM testsbase
# Keep the venv outside '/core' so mounting the repository there does not
#   hide it (or expose the host's venv).
ENV UV_PROJECT_ENVIRONMENT=/opt/venv
RUN mkdir /core
COPY ./pyproject.toml ./uv.lock /core/
WORKDIR /core

# Same steps as CI ('manage.sh create-env' and 'manage.sh run-tests')
RUN uv sync --all-extras
RUN uv sync --extra test
